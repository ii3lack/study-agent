# Python 编译缓存
__pycache__/
*.py[co]
*.pyc
*.pyo
*.egg-info

# 构建产物
build/
dist/
wheels/

# 日志文件
*.log

# 虚拟环境
.venv
venv/

# 密钥文件（切勿提交）
.env

# 工具缓存
.ruff_cache/

# AI 工作目录（工具操作的文件空间）
/work_space/

# Agent 配置（含敏感信息）
.claude/
.codex/

# 运行时数据（日志/记忆/会话）
/storage/

# 操作系统文件
.DS_Store
Thumbs.db

# 个人学习资料（不入库）
docs/superpowers/

# Obsidian 知识库（个人笔记，不入库）
vault/

# Node.js 遗留
node_modules/
package-lock.json

# Windows 保留设备名伪文件（Git Bash 下表现为 0 字节文件，无法删除）
nul
com1
com2
lpt1
aux

